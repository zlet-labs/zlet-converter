<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Zlet.FolderConverter.AvaloniaPoc.MainWindow"
        Title="Zlet Converter · Avalonia PoC"
        Width="1440" Height="900" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9" FontFamily="Inter">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#246BFD"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#EAF1FF"/>
      <Setter Property="Foreground" Value="#1E5DDA"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6E7787"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="180,*,380" RowDefinitions="62,*,64">
    <Border Grid.RowSpan="3" Background="#FFFFFF" BorderBrush="#E3E6EB" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="70,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,18,12,14">
          <Border Width="30" Height="30" CornerRadius="7" Background="#246BFD">
            <TextBlock Text="Z" Foreground="White" FontWeight="Bold" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Zlet" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="Converter" Classes="muted"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,6,0,0">
          <Button Classes="nav selected" Content="▤   Convert"/>
          <Button Classes="nav" Content="◷   History"/>
          <Button Classes="nav" Content="✓   Quality"/>
          <Button Classes="nav" Content="⚙   Settings"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="18,0,14,18" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="7" Height="7" Fill="#25A56A" VerticalAlignment="Center"/>
            <TextBlock Text="Local processing" Classes="muted"/>
          </StackPanel>
          <TextBlock Text="{Binding CoreProbeText}" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Grid.ColumnSpan="2" Background="#FFFFFF"
            BorderBrush="#E3E6EB" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="20,0" ColumnSpacing="8">
        <Button Grid.Column="0" Content="+  Add files" Click="AddFiles_Click"/>
        <Button Grid.Column="1" Content="+  Add folder" Click="AddFolder_Click"/>
        <TextBlock Grid.Column="2" Text="{Binding QueueSummary}" Classes="muted"
                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
        <Button Grid.Column="3" Classes="primary" Content="{Binding StressButtonText}" Click="Stress_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="74,42,*" Margin="20,18,18,16">
      <Grid ColumnDefinitions="*,150,150" ColumnSpacing="10">
        <TextBox Grid.Column="0" Watermark="Search files…" Height="34" VerticalAlignment="Top"/>
        <ComboBox Grid.Column="1" SelectedIndex="0" Height="34">
          <ComboBoxItem Content="All statuses"/>
          <ComboBoxItem Content="Queued"/>
          <ComboBoxItem Content="Converting"/>
          <ComboBoxItem Content="Failed"/>
        </ComboBox>
        <ComboBox Grid.Column="2" SelectedIndex="0" Height="34">
          <ComboBoxItem Content="All routes"/>
          <ComboBoxItem Content="DOCX → MD"/>
          <ComboBoxItem Content="PDF → MD"/>
        </ComboBox>
      </Grid>

      <Border Grid.Row="1" Background="#F1F3F6" BorderBrush="#E2E5EA"
              BorderThickness="1,1,1,0" CornerRadius="7,7,0,0">
        <Grid ColumnDefinitions="2.2*,130,140,180,130" ColumnSpacing="12" Margin="12,0">
          <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Operation" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="Status" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="Progress" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="Quality" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E5EA"
              BorderThickness="1" CornerRadius="0,0,7,7">
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#ECEEF2" BorderThickness="0,0,0,1">
                <Grid Height="42" ColumnDefinitions="2.2*,130,140,180,130"
                      ColumnSpacing="12" Margin="12,0">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" FontSize="13"/>
                  <TextBlock Grid.Column="1" Text="{Binding Operation}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" FontSize="12" Foreground="#566173"/>
                  <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" FontSize="12"/>
                  <Grid Grid.Column="3" ColumnDefinitions="*,42" ColumnSpacing="8" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Classes="muted"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Grid.Column="4" Text="{Binding Quality}" VerticalAlignment="Center"
                             FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <Border Grid.Row="1" Grid.Column="2" Background="#FFFFFF"
            BorderBrush="#E3E6EB" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="22,20" Spacing="18">
          <StackPanel Spacing="5">
            <TextBlock Text="Inspector" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Selected file and conversion settings" Classes="muted"/>
          </StackPanel>

          <Border Background="#F8F9FB" BorderBrush="#E4E7EC" BorderThickness="1"
                  CornerRadius="8" Padding="14">
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding SelectedItem.Name}" FontWeight="SemiBold"
                         FontSize="14" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedItem.Output}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <StackPanel Spacing="8">
            <TextBlock Text="Conversion" FontWeight="SemiBold"/>
            <ComboBox SelectedIndex="0">
              <ComboBoxItem Content="Markdown (.md)"/>
            </ComboBox>
            <CheckBox Content="Preserve structure" IsChecked="True"/>
            <CheckBox Content="Extract images"/>
            <CheckBox Content="OCR if needed"/>
          </StackPanel>

          <Separator/>

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="12" RowSpacing="8">
            <TextBlock Text="Conversion" Classes="muted"/>
            <TextBlock Grid.Column="1" Text="{Binding SelectedItem.Status}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="Progress" Classes="muted"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.ProgressText}"/>
            <TextBlock Grid.Row="2" Text="Quality" Classes="muted"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Quality}" FontWeight="SemiBold"/>
          </Grid>

          <Separator/>

          <StackPanel Spacing="8">
            <TextBlock Text="Output" FontWeight="SemiBold"/>
            <TextBox Text="C:\Zlet\Output" IsReadOnly="True"/>
            <CheckBox Content="Create ZIP after conversion"/>
          </StackPanel>

          <Border Background="#FFF7E7" BorderBrush="#F1D79B" BorderThickness="1"
                  CornerRadius="8" Padding="12">
            <TextBlock Text="PoC: 2,000 queue rows + frequent progress updates."
                       TextWrapping="Wrap" Foreground="#76500A" FontSize="12"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="#FFFFFF"
            BorderBrush="#E3E6EB" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" Margin="20,0">
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Overall progress" FontWeight="SemiBold" FontSize="12"/>
          <TextBlock Text="{Binding OverallText}" Classes="muted"/>
        </StackPanel>
        <ProgressBar Grid.Column="1" Value="{Binding OverallProgress}"
                     Minimum="0" Maximum="100" Height="7" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="Open output"/>
        <Button Grid.Column="3" Classes="primary" Content="Convert / Stress" Click="Stress_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
