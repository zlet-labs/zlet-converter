<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Zlet.FolderConverter.Core\Zlet.FolderConverter.Core.csproj" />
    <ProjectReference Include="..\Zlet.FolderConverter.OfficeWorker\Zlet.FolderConverter.OfficeWorker.csproj"
                      ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="DisplayVersion" Value="$(ZletDisplayVersion)" />
    <AssemblyMetadata Include="PortablePackageName" Value="$(ZletPortablePackageName)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>$(ZletExecutableName)</AssemblyName>
    <ApplicationIcon>Assets\ZletBatchConverter.ico</ApplicationIcon>
    <RootNamespace>Zlet.FolderConverter.App</RootNamespace>
    <RuntimeIdentifier>$(ZletPortableRuntimeIdentifier)</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ZletBatchConverter.ico" />
    <None Include="..\Zlet.FolderConverter.AnydocWorker\target\release\zlet-anydoc-worker.exe" Link="zlet-anydoc-worker.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Zlet.FolderConverter.AnydocWorker\target\release\zlet-anydoc-worker.exe')" />
  </ItemGroup>

  <Target Name="CopyOfficeWorkerToOutput"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <OfficeWorkerOutput Include="$(MSBuildProjectDirectory)\..\Zlet.FolderConverter.OfficeWorker\bin\$(Configuration)\net8.0-windows\**\Zlet.FolderConverter.OfficeWorker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(OfficeWorkerOutput)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
