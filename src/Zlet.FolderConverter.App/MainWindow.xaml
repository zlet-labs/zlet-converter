<Window x:Class="Zlet.FolderConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zlet.FolderConverter.App"
        mc:Ignorable="d"
        Title="Zlet Converter v0.0.2"
        Icon="Assets/ZletBatchConverter.ico"
        Width="1280"
        Height="780"
        MinWidth="900"
        MinHeight="540"
        Background="{StaticResource PageBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Ellipse Width="520"
                 Height="360"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-210,-190,0,0"
                 Fill="#332D5BFF"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="90" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="460"
                 Height="300"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-180,-180"
                 Fill="#2420B8FF"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="100" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static local:ProductIdentity.Name}"
                                   FontSize="27"
                                   FontWeight="SemiBold" />
                        <Border Margin="12,0,0,0"
                                Padding="8,4"
                                CornerRadius="8"
                                Background="#4338CA"
                                VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       LineHeight="16"
                                       LineStackingStrategy="BlockLineHeight">
                                <Run Text="PRE-ALPHA · v" />
                                <Run Text="{x:Static local:ProductIdentity.Version}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Subtitle}"
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource SettingsTitle}"
                        Style="{StaticResource CompactButtonStyle}"
                        Margin="0,0,10,0" Click="SettingsButton_Click" />
                <Border
                        Style="{StaticResource PrivacyBadgeStyle}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource PrivacyBadge}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#B9F4FF" />
                </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource GlassPanelStyle}"
                    Margin="0,0,0,10"
                    Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="#2D5BFF"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock Text="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold" />
                    </Border>

                    <Grid Grid.Column="1" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding SelectedFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding SelectedFolder}"
                                 Height="42"
                                 Padding="11,0"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="{Binding CanChangeSettings}"
                                 KeyDown="SourcePathTextBox_KeyDown" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding SourcePathError}"
                                   Foreground="#FF9AAA"
                                   FontSize="12"
                                   Margin="2,3,0,0"
                                   Visibility="{Binding HasSourcePathError, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <Button Grid.Column="2"
                            Content="{DynamicResource Copy}"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="{DynamicResource CopyPathTooltip}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanCopySelectedFolder}"
                            Click="CopyFolderButton_Click" />

                    <Button Grid.Column="3"
                            Content="{DynamicResource Browse}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanChangeSettings}"
                            Click="ChooseFolderButton_Click" />

                    <CheckBox Grid.Column="4"
                              Content="{DynamicResource IncludeSubfolders}"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IncludeSubfolders}"
                              Margin="0,0,12,0"
                              IsEnabled="{Binding CanChangeSettings}" />

                    <Button Grid.Column="5"
                            Content="{DynamicResource ScanFiles}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanScan}"
                            Click="ScanButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="310" MaxWidth="440" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="440" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource GlassPanelStyle}"
                            Padding="0"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="14,12,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        Background="#6D4AFF"
                                        Margin="0,0,9,0">
                                    <TextBlock Text="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Rules}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource RulesDescription}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="{DynamicResource EmptyRules}"
                                           Margin="16"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Visibility="{Binding HasRules, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <DataGrid x:Name="FormatRulesDataGrid"
                                          ItemsSource="{Binding FormatRules}"
                                          SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          RowHeight="52"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          PreviewMouseLeftButtonDown="FormatRules_PreviewMouseLeftButtonDown"
                                          PreviewKeyDown="FormatRules_PreviewKeyDown"
                                          Visibility="{Binding HasRules, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="BorderThickness" Value="2,0,0,0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#252A4268" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#38253D66" />
                                                    <Setter Property="BorderBrush" Value="#6D4AFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{DynamicResource Format}" Width="80" MinWidth="68">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="6,0,0,0">
                                                        <Border Style="{StaticResource RuleFormatBadgeStyle}">
                                                            <Path Style="{StaticResource RuleFormatIconStyle}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding FormatLabel}"
                                                                   ToolTip="{Binding FormatLabel}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{DynamicResource Found}" Width="38" MinWidth="32">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader"
                                                       BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="1,0" />
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Count}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                TextAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{DynamicResource Action}" Width="*" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center" Margin="2,0,4,0">
                                                        <ComboBox ItemsSource="{Binding Targets}"
                                                                  SelectedItem="{Binding SelectedTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding DataContext.CanChangeRules, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  HorizontalAlignment="Stretch"
                                                                  Cursor="Arrow"
                                                                  Visibility="{Binding HasMultipleTargets, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Border Background="#1C2234"
                                                                BorderBrush="#2D3748"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="7,5"
                                                                HorizontalAlignment="Stretch"
                                                                ToolTipService.ShowDuration="10000"
                                                                Visibility="{Binding IsSingleAction, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Border.ToolTip>
                                                                <ToolTip Background="#1F2437" BorderBrush="#3D4566" Foreground="#E2E8F0">
                                                                    <StackPanel MaxWidth="280">
                                                                        <TextBlock Text="{Binding SingleActionTooltip}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding SingleActionReason}" Margin="0,4,0,0" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Border.ToolTip>
                                                            <TextBlock Text="{Binding SelectedTarget.Label}"
                                                                       Foreground="#8896AB"
                                                                       FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource GlassPanelStyle}"
                            Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        Background="#0284C7"
                                        Margin="0,0,9,0">
                                    <TextBlock Text="3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource DestinationTitle}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource DestinationDescription}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding OutputModes}"
                                          SelectedItem="{Binding SelectedOutputModeOption}"
                                          IsEnabled="{Binding CanChangeSettings}"
                                          Height="36">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Content="{Binding OutputBrowseButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding CanChangeSettings}"
                                        Click="ChooseOutputButton_Click"
                                        Height="36" />
                                <Button Grid.Column="4"
                                        Content="{DynamicResource Reset}"
                                        Style="{StaticResource CompactButtonStyle}"
                                        IsEnabled="{Binding CanChangeSettings}"
                                        Click="ResetOutputButton_Click"
                                        Height="36" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding OutputPath}"
                                         Height="38"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="{Binding CanChangeSettings}" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding OutputPathError}"
                                           Foreground="#FF9AAA"
                                           FontSize="12"
                                           Margin="2,3,0,0"
                                           Visibility="{Binding HasOutputPathError, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2"
                        Style="{StaticResource GlassPanelStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="130" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,12,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="#228BF4"
                                    Margin="0,0,9,0">
                                <TextBlock Text="4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Preview}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StateMessage}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="ShowAllButton"
                                        Content="{DynamicResource ShowAll}"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Height="38"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding IsPreviewFiltered, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="ShowAllButton_Click" />
                                <ComboBox Width="160"
                                          ItemsSource="{Binding PreviewFilters}"
                                          SelectedItem="{Binding SelectedPreviewFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#670A1323"
                                BorderBrush="#16243A"
                                BorderThickness="0,1"
                                Padding="14,8">
                            <UniformGrid Columns="6">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Found}" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding FoundCount}" Style="{StaticResource MetricValueStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ReadyMetric}" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding ReadyCount}" Style="{StaticResource MetricValueStyle}" Foreground="#70E4FF" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SkipMetric}" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricValueStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource UnavailableMetric}" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding UnavailableCount}" Style="{StaticResource MetricValueStyle}" Foreground="#FFD37A" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ConflictsMetric}" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource MetricValueStyle}" Foreground="#FBBF72" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ErrorsMetric}" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding ErrorCount}" Style="{StaticResource MetricValueStyle}" Foreground="#FF8E9E" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Grid.Row="2"
                                Background="#470A1323"
                                BorderBrush="#16243A"
                                BorderThickness="0,0,0,1"
                                Padding="14,7"
                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBlock Text="{Binding FilteredCountSummary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Visibility="{Binding IsPreviewFiltered, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding CopyListStatus}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectionSummary}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#70E4FF" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource SelectAll}"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding CanChangeSettings}"
                                            Click="SelectAllButton_Click" />
                                    <Button Content="{DynamicResource ClearSelection}"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding CanChangeSettings}"
                                            Click="ClearSelectionButton_Click" />
                                    <Button Content="{DynamicResource InvertSelection}"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding CanChangeSettings}"
                                            Click="InvertSelectionButton_Click" />
                                    <Button Content="{DynamicResource CopyList}"
                                            Style="{StaticResource CompactButtonStyle}"
                                            IsEnabled="{Binding CanCopyConversionList}"
                                            Click="CopyConversionListButton_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="3"
                                Margin="12,8,12,0"
                                Padding="12,6"
                                CornerRadius="6"
                                Background="#4420334D"
                                BorderBrush="#2D4566"
                                BorderThickness="1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Office"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#70E4FF" />
                                <WrapPanel Grid.Column="1"
                                           VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center">
                                        <Border Style="{StaticResource OfficeWordBadgeStyle}">
                                            <TextBlock Text="W" Style="{StaticResource OfficeBadgeTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{Binding WordOfficeStatus}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center">
                                        <Border Style="{StaticResource OfficeExcelBadgeStyle}">
                                            <TextBlock Text="X" Style="{StaticResource OfficeBadgeTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{Binding ExcelOfficeStatus}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Border Style="{StaticResource OfficePowerPointBadgeStyle}">
                                            <TextBlock Text="P" Style="{StaticResource OfficeBadgeTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{Binding PowerPointOfficeStatus}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="24"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Visibility="{Binding HasPreview, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                            <DataGrid x:Name="OperationsDataGrid"
                                      ItemsSource="{Binding VisibleOperations}"
                                      AutoGenerateColumns="False"
                                      BorderThickness="0"
                                      MinRowHeight="32"
                                      CellStyle="{StaticResource PreviewDataGridCellStyle}"
                                      CanUserSortColumns="True"
                                      Sorting="OperationsDataGrid_Sorting"
                                      Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="#" Width="38" MinWidth="32" CanUserSort="False">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader"
                                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayIndex}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="13" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader"
                                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelect}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{DynamicResource SourceFile}"
                                                            Width="2*"
                                                            MinWidth="95"
                                                            CanUserSort="True"
                                                            SortMemberPath="SourceFile">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FilePath}"
                                                           ToolTip="{Binding SourcePath}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{DynamicResource Action}"
                                                        Binding="{Binding ActionLabel}"
                                                        Width="110"
                                                        MinWidth="85"
                                                        CanUserSort="True"
                                                        SortMemberPath="Action"
                                                        ElementStyle="{StaticResource PreviewTextColumnElementStyle}" />
                                    <DataGridTemplateColumn Header="{DynamicResource Status}"
                                                            Width="140"
                                                            MinWidth="95"
                                                            CanUserSort="True"
                                                            SortMemberPath="Status">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource StatusChipBorderStyle}"
                                                            ToolTip="{Binding Message}">
                                                        <TextBlock Text="{Binding Status}"
                                                                   Style="{StaticResource StatusChipTextStyle}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{DynamicResource QualityHeader}" Width="110" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <TextBlock Text="{Binding QualityStatus}" ToolTip="{Binding QualitySummary}" VerticalAlignment="Center"/>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{DynamicResource Result}"
                                                            Width="1.2*"
                                                            MinWidth="50"
                                                            CanUserSort="True"
                                                            SortMemberPath="Result">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResultPath}"
                                                           ToolTip="{Binding TargetPath}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{DynamicResource Size}"
                                                        Binding="{Binding FileSizeText}"
                                                        Width="58"
                                                        MinWidth="40"
                                                        CanUserSort="True"
                                                        SortMemberPath="Size"
                                                        ElementStyle="{StaticResource PreviewTextColumnElementStyle}" />
                                    <DataGridTextColumn Header="{DynamicResource Time}"
                                                        Binding="{Binding ExecutionTimeText}"
                                                        Width="54"
                                                        MinWidth="36"
                                                        CanUserSort="True"
                                                        SortMemberPath="Time"
                                                        ElementStyle="{StaticResource PreviewTextColumnElementStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Border Grid.Row="5"
                                Background="#550A1323"
                                BorderBrush="#16243A"
                                BorderThickness="0,1,0,0"
                                Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectionSummary}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#70E4FF" />
                                        <TextBlock Text="{Binding StateMessage}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding ShowProgress, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding ConvertButtonText}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="42"
                                            MinWidth="210"
                                            IsEnabled="{Binding CanConvert}"
                                            Click="ConvertButton_Click" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="0,10,0,0"
                                        Padding="12,10"
                                        CornerRadius="8"
                                        Background="#99132136"
                                        BorderBrush="#36527A"
                                        BorderThickness="1"
                                        Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Conversion}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProgressCountText}"
                                                   Margin="16,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ProgressPercentText}"
                                                   Margin="16,0,0,0"
                                                   FontWeight="Bold"
                                                   Foreground="#70E4FF" />
                                        <Button Grid.Column="3"
                                                Content="{Binding StopButtonText}"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Margin="16,-4,0,-4"
                                                MinWidth="112"
                                                IsEnabled="{Binding CanStop}"
                                                Click="StopButton_Click" />
                                        <ProgressBar Grid.Row="1"
                                                     Grid.ColumnSpan="4"
                                                     Height="8"
                                                     Margin="0,7,0,7"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding CurrentFileText}"
                                                   ToolTip="{Binding CurrentFile}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="{Binding ElapsedTimeText}"
                                                   Margin="16,0,0,0"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="2"
                                                   Text="{Binding RemainingTimeText}"
                                                   Margin="16,0,0,0"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="6"
                                Margin="12,6,12,12"
                                Padding="12"
                                CornerRadius="8"
                                Background="#9920334D"
                                BorderBrush="#36527A"
                                BorderThickness="1"
                                Visibility="{Binding HasFinalReport, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding FinalReportTitle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WorksheetSummaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding ReportStatusText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <WrapPanel Margin="0,5,0,0">
                                        <TextBlock Text="{Binding FinalConvertedText}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalCopiedText}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalFailedText}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalConflictsText}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalUnavailableText}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding FinalSkippedText}" />
                                        <TextBlock Text="{Binding FinalNotSelectedText}" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding FinalDurationText}" Margin="14,0,0,0" FontWeight="SemiBold" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ResultFolder}"
                                               ToolTip="{Binding ResultFolder}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontSize="14"
                                               Margin="0,4,0,0" />
                                    <Border Margin="0,8,0,0"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="#33FF647C"
                                            BorderBrush="#88FF647C"
                                            BorderThickness="1"
                                            Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource FileErrors}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFB4BE" />
                                            <ScrollViewer MaxHeight="96"
                                                          Margin="0,4,0,0"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ErrorMessages}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#FFD7DC"
                                                                       ToolTip="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <Button Content="{Binding ResultActionText}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="180"
                                            Margin="0,0,0,8"
                                            IsEnabled="{Binding CanOpenResult}"
                                            Click="OpenResultButton_Click" />
                                    <Button Content="{DynamicResource OpenReport}"
                                            Style="{StaticResource CompactButtonStyle}"
                                            MinWidth="180"
                                            Margin="0,0,0,8"
                                            IsEnabled="{Binding CanOpenReport}"
                                            Click="OpenReportButton_Click"
                                            Visibility="{Binding CanOpenReport, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="{DynamicResource CopyList}"
                                            Style="{StaticResource CompactButtonStyle}"
                                            MinWidth="180"
                                            IsEnabled="{Binding CanCopyConversionList}"
                                            Click="CopyConversionListButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
