<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Zlet.Quality.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>Zlet</Authors>
    <Description>Deterministic source-to-Markdown quality evaluation core for Zlet.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
