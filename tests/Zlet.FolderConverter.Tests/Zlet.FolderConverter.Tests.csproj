<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zlet.FolderConverter.App\Zlet.FolderConverter.App.csproj" />
    <ProjectReference Include="..\..\src\Zlet.FolderConverter.Core\Zlet.FolderConverter.Core.csproj" />
    <ProjectReference Include="..\..\src\Zlet.FolderConverter.OfficeWorker\Zlet.FolderConverter.OfficeWorker.csproj" />
    <None Include="..\..\src\Zlet.FolderConverter.AnydocWorker\target\release\zlet-anydoc-worker.exe" Link="zlet-anydoc-worker.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\src\Zlet.FolderConverter.AnydocWorker\target\release\zlet-anydoc-worker.exe')" />
  </ItemGroup>

  <!-- Build the mock anydoc worker and copy its exe to the test output directory. -->
  <!-- ReferenceOutputAssembly=false: we don't want to link it, just trigger the build. -->
  <ItemGroup>
    <ProjectReference
      Include="..\Zlet.FolderConverter.MockAnydocWorker\Zlet.FolderConverter.MockAnydocWorker.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="None"
      Private="false" />
  </ItemGroup>

  <!-- Copy the built mock worker and all its runtime files into a mock-workers/ subdirectory
       so the framework-dependent exe can be launched correctly from tests. -->
  <Target Name="CopyMockAnydocWorker" AfterTargets="Build">
    <PropertyGroup>
      <_MockWorkerDir>$(MSBuildThisFileDirectory)..\Zlet.FolderConverter.MockAnydocWorker\bin\$(Configuration)\net8.0-windows</_MockWorkerDir>
    </PropertyGroup>
    <ItemGroup>
      <_MockWorkerFiles Include="$(_MockWorkerDir)\zlet-mock-anydoc-worker.exe" />
      <_MockWorkerFiles Include="$(_MockWorkerDir)\zlet-mock-anydoc-worker.dll" />
      <_MockWorkerFiles Include="$(_MockWorkerDir)\zlet-mock-anydoc-worker.runtimeconfig.json" />
      <_MockWorkerFiles Include="$(_MockWorkerDir)\zlet-mock-anydoc-worker.deps.json" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_MockWorkerFiles)"
      DestinationFolder="$(OutputPath)mock-workers"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_MockWorkerDir)\zlet-mock-anydoc-worker.exe')" />
  </Target>

</Project>

